---
// 全站外壳：页头、目录条、页尾照现在网站（src/chrome 里的原样 HTML 和原样式）。
// 正文区块：tools/render_blocks.py 用现在网站的区块库排好，样式是同一份（public/assets/_typeset/typeset.css），
// 字体是同一个字体文件按本页用字抽的子集；画布按栏宽等比缩放（电脑画布 1672、手机画布 941）。
// 动效：翻页过渡、站点运行脚本（水彩、落叶、回顶、小鸟彩蛋）、环境动画引擎，都是现有页面实际加载的原文件，
// 只把翻页数据里“插画、标题在哪”改指新页的元素（见 albumMeta）。
import header from '../chrome/header.html?raw';
import footer from '../chrome/footer.html?raw';
import chrome from '../chrome/chrome.json';
import livingEngine from '../chrome/living-engine.json';
import albumRuntime from '../../public/_album/astro-runtime.json';
import '../styles/typeset-page.css';
import tocConsistency from '../../../scripts/toc-consistency.js?url&no-inline';
const runtimes = import.meta.glob('../chrome/runtime/*.json', { eager: true, import: 'default' }) as Record<string, any>;
interface Props { title: string; kind: string; url: string; page: string; motion?: any; blocks?: any; pageMeta?: any; moved?: string; noindex?: boolean; toc: { id: string; label: string; img?: string }[] }
const { title, kind, url, toc, page, motion, blocks, pageMeta, moved, noindex } = Astro.props;
const rt = runtimes[`../chrome/runtime/${page}.json`];

function albumMeta() {
  const old = rt.album;
  const first = (old.nodes || []).find((n: any) => n.orientation === 'h') || {};
  const nodes: any[] = [];
  if (motion?.art) nodes.push({ screen: motion.screen, selector: `[data-art-key="${motion.art.key}"]`, src: motion.art.src, size: motion.art.size, orientation: 'h',
    arts: [{ key: motion.art.key, rect: [0, 0, 1, 1] }], primary: null, links: first.links || [], title: null });
  if (motion?.brush) nodes.push({ screen: motion.screen, selector: `[data-title-key="${motion.brush.key}"]`, src: motion.brush.src, size: motion.brush.size, orientation: 'h',
    arts: [], primary: null, links: [], title: [0, 0, 1, 1], titleKey: first.titleKey });
  const images = [motion?.art, motion?.brush].filter(Boolean).map((x: any) => ({ src: x.src, both: true }));
  return { ...old, entry: motion?.screen || old.entry, nodes, images };
}
const safe = (o: unknown) => JSON.stringify(o).replace(/</g, '\u003c');
// 目录条高亮（站点脚本）按目录顺序取“最后一个已经滚过的目标”。目标在页面里的先后和目录顺序不一致时，这一项会一直被当成当前项，
// 手机上目录条也跟着一直横滚到它（例如基座页“我的 AI 实践”指向第一屏里的入口按钮）。这种项照样能点（href 不变），只是不参与高亮和自动横滚。
const tocOrder = new Map<string, number>();
(blocks?.screens || []).forEach((s: any, i: number) => { for (const id of [s.id, s.anchor, ...(s.points || [])]) if (id && !tocOrder.has(id)) tocOrder.set(id, i); });
const tocHtml = (() => {
  if (!rt?.toc_html) return null;
  let last = -1;
  return rt.toc_html.replace(/<nav\b(?![^>]*\bdata-toc-consistency\b)/, '<nav data-toc-consistency="uniform-v1"').replace(/<a class="nav-link"([^>]*?) data-section="([^"]+)"/g, (m: string, pre: string, sec: string) => {
    const i = tocOrder.get(sec);
    if (i === undefined) return m;
    // data-section 还得留着（目录标签图按它找项），换个页面里没有的名字，高亮脚本就找不到它的目标、跳过这一项
    if (i < last) return `<a class="nav-link"${pre} data-section="${sec}-jump" data-toc-target="${sec}"`;
    last = i; return m;
  });
})();
const withoutTocRuntime = (html: string) => html.replace(/<script\b[^>]*\b(?:data-src|src)="[^"]*toc-consistency[^"]*"[^>]*><\/script>/g, '');
const head = rt ? withoutTocRuntime(rt.head.map((h: string) => h.startsWith('<script id="album-page"')
  ? `<script id="album-page" type="application/json">${safe(albumMeta())}</script>`
  : /<script[^>]*data-album-inline/.test(h) ? `<script data-album-inline>${albumRuntime.source}</script>`
  : h.replace(/\/_album\/album-[\w]+\.css/g, albumRuntime.css)).join('\n')) : '';
// 站点运行脚本按 page-data 里的旧“整屏图”逐屏排版；新页没有整屏图，把屏清单置空，其余（落叶、水彩、页头、目录用的共用数据）原样
// “复制 AI 续作说明”（项目页、冻结页）：现在网站只在脚本里临时造一个 #ai-brief 对话框，脚本没跑时按钮点了没反应。
// 这里在页面末尾放一个真实的 #ai-brief：没有脚本也能跳到这里、看到并手动复制说明；脚本在时照旧弹对话框（静态这块隐藏、改名让出 id）。
// 现在网站上没有对应页、因而没有运行件的页（例如旧项目名的别名页），用内容文件里的页面数据
const pageData = (() => { const m = rt?.tail.match(/<script id="page-data" type="application\/json">(.*?)<\/script>/s); try { return m ? JSON.parse(m[1]) : null; } catch { return null; } })() ?? pageMeta ?? null;
const authorPages = import.meta.glob('../../../sources/pages/*/page.json', { eager: true, import: 'default' }) as Record<string, any>;
const briefRepo = pageData ? (pageData.status_binding?.repo || (pageData.repo_url ? String(pageData.repo_url).replace(/^https:\/\/github.com\//, '') : '页面未提供仓库地址')) : '';
const briefText = pageData && ['project', 'frozen'].includes(pageData.kind)
  ? `项目：${pageData.title}；${briefRepo.startsWith('private-project-') ? '项目键' : '仓库'}：${briefRepo}；范围：整个项目；目标：（这里写这次要做的事）。先读项目的 AGENTS.md 和说明，按现行规则做。` : '';
const tail = rt ? withoutTocRuntime(rt.tail).replace(`/_living/_engine/${livingEngine.deployed}`, `/_living/_engine/${livingEngine.fixed}`).replace(/(<script id="page-data" type="application\/json">)(.*?)(<\/script>)/s, (_m: string, a: string, body: string, c: string) => {
  const d = JSON.parse(body); d.screens = [];
  d.status_binding = { ...d.status_binding, empty_text: Object.fromEntries((authorPages[`../../../sources/pages/${page}/page.json`]?.registry?.live || []).filter((x: any) => typeof x.empty_text === 'string').map((x: any) => [x.slot, x.empty_text])) };
  return a + safe(d) + c;
}) : '';
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · 吴乐阳</title>
  <link rel="canonical" href={new URL(url, 'https://wly0829.cn').href} />
  {moved && <meta http-equiv="refresh" content={`2; url=${moved}`} />}
  {(moved || noindex) && <meta name="robots" content="noindex" />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script is:inline defer src={blocks?.loader || '/_living/living-mount.js'}></script>
  {chrome.css.map((href) => <link rel="stylesheet" href={href} />)}
  <Fragment set:html={head} />
  {blocks && <link rel="preload" as="font" type="font/woff2" href={blocks.font} crossorigin="anonymous" />}
  {blocks && <link rel="stylesheet" href={blocks.css} />}
  <noscript><style>.ts-page [data-ts-src],.ts-page [data-ts-lazy] {display:none!important}</style></noscript>
  {blocks && <Fragment set:html={`<style>@font-face{font-family:"Sans";src:url("${blocks.font}") format("woff2");font-weight:100 900;font-display:block}</style>`} />}
</head>
<body data-page-kind={kind} class="astro-page">
  <a class="skip" href="#content">跳到正文</a>
  <Fragment set:html={header} />
  {tocHtml ? <Fragment set:html={tocHtml} /> : toc.length > 0 && (
    <nav data-toc-consistency="uniform-v1" class="toc" aria-label="本页目录"><div class="bar-inner"><div class="toc-inner toc-text">
      {toc.map((t) => (
        <a class="nav-link" href={'#' + t.id} data-section={t.id} data-label-h={t.label} data-label-v={t.label}>
          {t.img
            ? <span class="nav-label"><img class="toc-img" src={t.img} alt={t.label} /></span>
            : <span class="nav-label">{t.label}</span>}
        </a>
      ))}
    </div></div></nav>
  )}
  <main id="content" class="paper ts-page">
    <script is:inline>(()=>{const m=document.currentScript.parentElement;const z=()=>{const w=m.clientWidth;if(!w)return;m.style.setProperty('--tz-h',String(w/1672));m.style.setProperty('--tz-v',String(w/941));m.style.setProperty('--tz-card',String((innerWidth<768?w:(w-16)/2)/1672));};z();new ResizeObserver(z).observe(m);
const fit=()=>{for(const c of m.querySelectorAll('.ts-canvas')){const o=c.parentElement,h=c.offsetHeight;if(h&&h>parseFloat(o.style.getPropertyValue('--ch')))o.style.setProperty('--ch',h+'px');}};document.fonts.ready.then(fit);addEventListener('load',fit);document.addEventListener('site-live-layout',fit);
const activate=e=>{if(!(e.target instanceof Element))return;const t=e.target.closest('.ts-canvas [data-href]:not(a):not([data-hot="live"]),.rule-original-prose a[data-href]:not([href])');if(!t)return;
if(t.matches('button[data-href="刷新状态"]')){e.preventDefault();window.SiteB2?.refresh?.();return;}
if(t.matches('.slot-shot-frame')&&window.SiteImageViewer?.openGallery){const shots=[...m.querySelectorAll('.slot-shot-frame[data-href]')].filter(s=>s.getClientRects().length);const list=shots.map(s=>({src:new URL(s.dataset.href,location.href).href,title:s.closest('.c-slot-shots')?.querySelector(`[data-shot-caption-index="${s.closest('.slot-shot-item')?.dataset.shotIndex}"]`)?.textContent.trim()||'截图'}));e.preventDefault();window.SiteImageViewer.openGallery(list,shots.indexOf(t),t);}else location.href=t.dataset.href;};
document.addEventListener('click',activate);
document.addEventListener('keydown',e=>{if(e.key==='Enter'||(e.key===' '&&e.target instanceof Element&&e.target.closest('.slot-shot-frame[data-href]')))activate(e);});})();</script>
    <slot />
    {briefText && (
      <section id="ai-brief" class="ai-brief-static" aria-label="复制 AI 续作说明">
        <h2>复制 AI 续作说明</h2>
        <p class="ai-brief-text">{briefText}</p>
        <p class="ai-brief-note">把“目标”换成这次要做的事，整段复制给 AI。</p>
      </section>
    )}
  </main>
  <Fragment set:html={footer} />
  {briefText && <script is:inline>(()=>{const s=document.getElementById('ai-brief');if(s&&s.classList.contains('ai-brief-static')){s.id='ai-brief-text';s.hidden=true;}})();</script>}
  <script is:inline>(()=>{/* 手机上往下读时把“回到顶部”收起来，往上翻时再出来（停手 2.5 秒又收起），免得压住正文 */if(!matchMedia('(max-width: 767.98px)').matches)return;let y=scrollY,idle=0;const root=document.documentElement;root.classList.add('btt-hide');addEventListener('scroll',()=>{const d=scrollY-y;y=scrollY;if(Math.abs(d)<4)return;root.classList.toggle('btt-hide',d>0);clearTimeout(idle);if(d<0)idle=setTimeout(()=>root.classList.add('btt-hide'),2500);},{passive:true});
    /* 手机子导航：哪一头后面还有项，哪一头淡出 */
    /* 站点脚本可能重画目录条，所以每次现找，滚动在捕获阶段统一听 */
    /* 淡出宽度按露出半截的那一项算：半截的项整个落在淡出里，从它前面的空隙开始变淡，看着是“后面还有”，不是截断的字；那一头没有半截的项时只在边距里淡出，不碰完整的项 */
    const edge=()=>{const ti=document.querySelector('nav.toc .toc-inner');if(!ti)return;const max=ti.scrollWidth-ti.clientWidth,b=ti.getBoundingClientRect();let fl=0,fr=0;
      for(const a of ti.querySelectorAll(':scope > a')){const r=a.getBoundingClientRect();if(r.left<b.left-1&&r.right>b.left+1)fl=Math.max(fl,r.right-b.left+10);if(r.right>b.right+1&&r.left<b.right-1)fr=Math.max(fr,b.right-r.left+10);}
      const L=ti.scrollLeft>2,R=ti.scrollLeft<max-2;ti.classList.toggle('toc-more-left',L);ti.classList.toggle('toc-more-right',R);
      ti.style.setProperty('--toc-fl',L?(fl?Math.min(Math.max(fl,24),b.width/2):12)+'px':'0px');ti.style.setProperty('--toc-fr',R?(fr?Math.min(Math.max(fr,24),b.width/2):12)+'px':'0px');};
    document.addEventListener('scroll',(e)=>{if(e.target instanceof Element&&e.target.matches('nav.toc .toc-inner'))edge();},{capture:true,passive:true});
    addEventListener('resize',edge);addEventListener('load',edge);edge();})();</script>
  <Fragment set:html={tail} />
  <script is:inline defer src={tocConsistency}></script>
  {pageData && <script is:inline defer src="/_living/live-dom.js"></script>}
  {blocks && <script is:inline>(()=>{/* 屏淡入（照旧站 reveal 实测：整屏一起从下方 100px 升起、透明度 0→1，800 毫秒；第一屏、卡片网格里的卡片屏、
    带 # 进来的那屏、motion-off、减少动态效果时不播；屏进视口 6% 时加 .ts-entering，播完摘掉。样式在 typeset-page.css） */
    if(!('IntersectionObserver' in window)||matchMedia('(prefers-reduced-motion: reduce)').matches)return;
    const go=()=>{const all=[...document.querySelectorAll('main.ts-page section.ts-screen')],first=all[0];
      const hit=location.hash?document.getElementById(decodeURIComponent(location.hash.slice(1)))?.closest('.ts-screen'):null;
      const io=new IntersectionObserver(es=>es.forEach(e=>{if(!e.isIntersecting)return;const sec=e.target;io.unobserve(sec);
        if(sec===first||sec===hit||sec.dataset.seen||sec.parentElement?.classList.contains('ts-card-grid')||document.body.classList.contains('motion-off'))return;
        sec.dataset.seen='1';sec.classList.add('ts-entering');
        sec.addEventListener('animationend',ev=>{if(ev.target===sec)sec.classList.remove('ts-entering');});}),{threshold:.06});
      all.forEach(x=>io.observe(x));};
    if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',go,{once:true});else go();})();</script>}
</body>
</html>
