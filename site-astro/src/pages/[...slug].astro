---
import { getCollection } from 'astro:content';
import Site from '../layouts/Site.astro';

// 每页的区块由 tools/render_blocks.py 照内容文件排好（电脑画布 1672、手机画布 941 各一份），这里只拼进页面外壳。
const rendered = import.meta.glob('../content/rendered/*.json', { eager: true, import: 'default' }) as Record<string, any>;

export async function getStaticPaths() {
  const done = import.meta.glob('../content/rendered/*.json');  // getStaticPaths 单独运行，只能用这里自己导入的
  const pages = (await getCollection('pages')).filter((entry) => {
    if (entry.data.redirect) return true;  // 退役技能的去向页不排版
    if (done[`../content/rendered/${entry.id}.json`]) return true;
    console.warn(`${entry.id}：没有排版结果（tools/render_blocks.py 这一页出错或没跑），这一页不生成`);
    return false;
  });
  // 改过地址的页（page.json 的 old_urls）：旧地址出一句话的去向页，指到现在的页面
  // （现在网站上旧地址只剩素材目录，打开是目录列表）
  const moved = pages.flatMap((entry) => (entry.data.old_urls || []).map((from: string) => ({
    params: { slug: from.replace(/^\/|\/$/g, '') },
    props: { moved: { to: entry.data.url, title: entry.data.title } },
  })));
  return [...pages.map((entry) => ({
    // 没有网址的页（404、GitHub 个人主页稿）放在 /<页名>/，不和首页撞
    params: { slug: entry.data.url.replace(/^\/|\/$/g, '') || entry.id },
    props: { entry },
  })), ...moved];
}
const { entry, moved } = Astro.props as { entry?: any; moved?: { to: string; title: string } };
const redirect = entry?.data.redirect as undefined | { destination: string; paragraphs: { text: string; href?: string }[][] };
const r = entry && !redirect ? rendered[`../content/rendered/${entry.id}.json`] : null;
if (entry && !redirect && !r) throw new Error(`${entry.id}：还没排版，先运行 python tools/render_blocks.py ${entry.id}`);
// 只给比对用：SX_RULE_CANVAS=1 构建时规则原文屏出排好的原文卡（不出网页字），用来和现在的原文排版图逐屏比；正式构建不设
const ruleCanvas = process.env.SX_RULE_CANVAS === '1';
const esc = (v: string) => String(v).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
const screen = (s: any) => `<section class="ts-screen" id="${esc(s.id)}" data-screen="${esc(s.id)}" data-section="${esc(s.section || '')}">`
  + (s.anchor ? `<div class="section-anchor" id="${esc(s.anchor)}"></div>` : '')
  // 屏内定位点：别的页链到这屏里的细位置（例如约法的 #L18）时落在这屏开头；站点样式里 .point-anchor 是绝对定位、不占位
  + (s.points || []).map((a: string) => `<span class="point-anchor typeset-screen-anchor" id="${esc(a)}" data-anchor-binding="screen"></span>`).join('')
  + (s.article && !ruleCanvas
    // 规则原文屏：只出网页字原文（水彩框），上面一行版本标签；原来下面那份排好的原文卡（“原文排版图与技术证据”）撤掉，免得原文出现两遍
    ? (s.article_label ? `<p class="rule-original-version">${esc(s.article_label)}</p>` : '') + `<article class="rule-original-prose">${s.article}</article>`
    : (s.h ? `<div class="ts-o ts-h${s.v ? '' : ' ts-both'}" style="--ch:${s.h.height}px">${canvas('h', s.h)}</div>` : '')
      + (s.v ? `<div class="ts-o ts-v" style="--ch:${s.v.height}px">${canvas('v', s.v)}</div>` : ''))
  + `</section>`;
const canvas = (o: string, x: any) =>
  `<div class="ts-canvas o-${o} ts-shape-${x.shape || ''}" style="min-height:${x.height}px;${x.style || ''}">${x.html}</div>${x.overlay || ''}`;
// 和现在网站一样：连续的独立卡（shape=card）放进两列卡片网格（手机一列）；别的屏（例如分类标题条）把网格断开、占满整行
const parts: string[] = [];
let grid: string[] = [];
for (const s of r?.screens || []) {
  if ((s.h || s.v)?.shape === 'card') { grid.push(screen(s)); continue; }
  if (grid.length) { parts.push(`<div class="ts-card-grid">${grid.join('')}</div>`); grid = []; }
  parts.push(screen(s));
}
if (grid.length) parts.push(`<div class="ts-card-grid">${grid.join('')}</div>`);
---
{moved ? (
  <Site title={moved.title} kind="moved" toc={[]} url={moved.to} page="moved" moved={moved.to}>
    <p class="moved-notice">“{moved.title}”换了地址，现在的页面在 <a href={moved.to}>{moved.to}</a>，两秒后自动跳过去。</p>
  </Site>
) : redirect ? (
  <Site title={entry.data.title} kind="moved" toc={[]} url={entry.data.url} page="moved" noindex>
    <div class="moved-notice">
      <h1 class="moved-title">{entry.data.title}</h1>
      {redirect.paragraphs.map((p) => <p>{p.map((x) => (x.href ? <a href={x.href}>{x.text}</a> : x.text))}</p>)}
    </div>
  </Site>
) : (
  <Site title={entry.data.title} kind={entry.data.kind} toc={entry.data.toc} url={entry.data.url} page={entry.id} motion={r.motion} blocks={r} pageMeta={entry.data.page}>
    <Fragment set:html={parts.join('')} />
  </Site>
)}
