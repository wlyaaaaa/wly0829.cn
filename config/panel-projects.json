{
  "schema": "wly.personal-panel-project-registry.v1",
  "refresh_policy": {
    "mode": "ai_managed_on_demand",
    "semantic_writer": "website_ai_task_only",
    "targeted_refresh_prompt": "刷新个人看板中的<project-id>",
    "full_refresh_prompt": "全部更新一下",
    "trigger": "displayed_fact_or_explanation_changed",
    "non_trigger": "implementation_change_that_does_not_change_any_displayed_fact",
    "website_repo": "wlyaaaaa/wly0829.cn",
    "website_project_type": "project",
    "website_task_rule": "create one fresh independent website task for one refresh goal; never reuse a completed task",
    "full_refresh_rule": "the current website AI task iterates enabled projects in registry order; unchanged projects remain byte-identical",
    "fact_collector_boundary": "scripts and providers collect evidence and verify contracts; they never write narrative content or decide materiality",
    "publication_boundary": "source project publication completes first; website refresh is a separate post-publication task and cannot block or roll back the source transaction",
    "task_creation_threshold": "create a website task only when the source owner confirms a material displayed fact or explanation would become wrong; path matches alone are candidates",
    "small_change_policy": "do not create an asynchronous task for formatting, refactors, timestamps, hash-only drift, blocked candidates already shown accurately, or other changes that do not alter a user decision",
    "default_change_policy": "no website change unless the existing page would make a material user judgment wrong",
    "anti_append_policy": "replace, merge or remove current content in place; never append refresh logs, duplicate sections, cards or timeline entries because a refresh ran",
    "evolution_policy": "record only important product stages; one entry may cover a date or date range and may merge multiple related changes",
    "rule_refresh_boundary": "Rules use only the verified current E release; dirty or unreleased source never overwrites it and does not block unrelated project refreshes",
    "initial_bundle_gzip_budget_kib": 256,
    "lazy_detail_required_at_project_count": 8,
    "bundle_scaling_policy": "before enabling the eighth project, project details must lazy-load and search must use a derived lightweight index",
    "allowed_presentation_modes": [
      "real_dashboard",
      "curated_packaging"
    ],
    "default_presentation_mode": "real_dashboard",
    "only_private_document": "docs/design/private-content-rules.md"
  },
  "projects": [
    {
      "id": "agents",
      "order": 1,
      "title": ".agents",
      "enabled": true,
      "presentation_mode": "real_dashboard",
      "route": "/projects/agents",
      "ai_refresh": {
        "content_path": "app/content-core.js",
        "semantic_revision": 3,
        "scope": "project overview, six modules, current E release Rules and Skills evidence",
        "collectors": [
          "git -C E:\\.agents status --porcelain=v2 --branch",
          "E:\\.agents\\tools\\Invoke-EAgentRulesRelease.ps1 -Mode Inspect -Json",
          "E:\\.agents\\tools\\Test-PersonalSkillSupply.ps1 -RequireInstalled -NoExternalEvidence -Json",
          "E:\\.agents\\tests\\Invoke-AllTests.ps1 -Scope Local -Parallel -Json",
          "E:\\.agents\\tools\\Test-ControlPlaneContractCoverage.ps1 -Json"
        ]
      },
      "source": {
        "repo": "wlyaaaaa/.agents",
        "visibility": "PRIVATE",
        "default_branch": "main",
        "local_root": "E:\\.agents"
      },
      "displayed_areas": [
        "project_overview",
        "six_modules",
        "active_rules",
        "skills_catalog",
        "validation_matrix",
        "evolution_and_operating_entries"
      ],
      "impact_sources": [
        {
          "kind": "e_rules_release",
          "owner": "E:\\.agents",
          "entry": "E:\\.agents\\tools\\Invoke-EAgentRulesRelease.ps1 -Mode Inspect -Json",
          "fields": [
            "status",
            "reason",
            "pointer.current.release_id",
            "pointer.current.git_commit",
            "pointer.current.ruleset_sha256",
            "pointer.current.release_record_sha256",
            "pointer.previous",
            "pointer.pointer_revision",
            "pointer_sha256",
            "pointer.activated_at_utc",
            "verified_current.required_rule_paths",
            "verified_current.files"
          ]
        },
        {
          "kind": "rule_semantics",
          "paths": [
            "AGENTS.md",
            "docs/contracts/agents.protected-major-actions.md",
            "docs/contracts/agents.authorization-delegation.md",
            "docs/contracts/agents.four-base-decision-context.md",
            "docs/contracts/agents.capability-routing.md"
          ]
        },
        {
          "kind": "project_architecture",
          "paths": [
            "README.md",
            "docs/contracts/README.md",
            "config/control-plane-contract-catalog.json",
            "config/e-rules-bootstrap.json",
            "config/e81-retirement-dispositions.json",
            "config/on-demand-plugin-catalog.json",
            "config/repository-bloat-budget.json",
            "releases/current-rules.json",
            "releases/*/release.json",
            "releases/*/AGENTS.md",
            "releases/*/docs/contracts/*.md",
            "tools/Invoke-ExecutionOwnerRegistry.ps1",
            "tools/Get-FourBaseDecisionContext.ps1",
            "tools/Invoke-EAgentRulesRelease.ps1",
            "tools/Invoke-EAgentRulesFastRelease.ps1"
          ]
        },
        {
          "kind": "skills_catalog",
          "paths": [
            "config/personal-skill-supply.json",
            "skills",
            "skills/**/SKILL.md",
            "plugins",
            "plugins/*/skills/**/SKILL.md",
            "docs/personal-skill-supply-recovery.md"
          ]
        },
        {
          "kind": "displayed_validation",
          "paths": [
            "tests/test-registry.json",
            "tests/Invoke-AllTests.ps1",
            "tests/Test-AllTestsRunner.ps1",
            "tests/Test-EAgentRulesRelease.ps1",
            "tests/Test-ExecutionOwnerRegistry.ps1",
            "tools/Test-ControlPlaneContractCoverage.ps1"
          ]
        }
      ],
      "refresh_rules": {
        "semantic_review_required_when": [
          "a displayed rule changes meaning",
          "a module responsibility or boundary changes",
          "a Skill is added, removed, retired, renamed, or changes its trigger, flow, boundary, dependency, failure, or maturity",
          "a displayed validation result changes interpretation rather than only timestamp"
        ],
        "snapshot_only_when": [
          "E release id, pointer, hash, commit, observation time, source checkout state, or validation count changes without semantic change"
        ],
        "ignore_when": [
          "comments, formatting, refactors, or tests change without changing a displayed fact",
          "an internal file outside impact_sources changes",
          "dirty or unreleased source exists but the website already states its exact non-active status and no displayed explanation changes",
          "only a timestamp, source commit, release hash, formatting, comment, or implementation detail changed and the last published page remains a truthful historical snapshot"
        ]
      }
    },
    {
      "id": "pcconfig",
      "order": 2,
      "title": "PCConfig",
      "enabled": true,
      "presentation_mode": "real_dashboard",
      "route": "/projects/pcconfig",
      "ai_refresh": {
        "content_path": "app/content-pcconfig.js",
        "semantic_revision": 2,
        "scope": "project overview and six modules",
        "collectors": [
          "git -C E:\\PCConfig status --porcelain=v2 --branch",
          "E:\\PCConfig\\tools\\Test-PCConfigDrift.ps1 -NoWrite -Json",
          "E:\\PCConfig\\tools\\Get-DevStorageHealth.ps1 -Json",
          "E:\\PCConfig\\tools\\Install-CoreRecoveryTasks.ps1 -Mode Inspect -Json",
          "E:\\PCConfig\\tools\\Invoke-CoreRecoveryMaintenance.ps1 -Mode Inspect -Json",
          "E:\\PCConfig\\tools\\Invoke-PCConfigAcceptance.ps1 -NoWrite -Area core_recovery -Json",
          "E:\\PCConfig\\tools\\Get-RuntimeInventory.ps1 -Json",
          "E:\\PCConfig\\tools\\Get-StartupInventory.ps1 -Json",
          "E:\\PCConfig\\tools\\Invoke-StableMachineProjection.ps1 -Action Read -Json",
          "E:\\PCConfig\\tools\\Invoke-SecretBroker.ps1 -Action Status -Json",
          "E:\\PCConfig\\tools\\Invoke-GoogleWorkspaceProvider.ps1 -Action Status -Json",
          "E:\\PCConfig\\tools\\Get-GoogleWorkspaceProviderBinding.ps1 -Json",
          "E:\\PCConfig\\tools\\Install-ProtectedDataSafeSwitch.ps1 -Mode Inspect -Json",
          "read C:\\ProgramData\\PCConfig\\ProtectedDataSafeSwitch\\v1\\public\\status.json and boot-latest.json",
          "read E:\\PCConfig\\registries\\protected_data_vault_v2_formal.json and protected_data_p5_p7_delivery_v3.json"
        ],
        "conditional_collectors": [
          "E:\\PCConfig\\tools\\Get-ProtectedPolicyAuthorityStatus.ps1 -Json when displayed protected-policy retirement state may change",
          "owner-specific protected installers/tests only when their displayed implementation or evidence changed"
