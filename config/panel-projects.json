      },
      "source": {
        "repo": "wlyaaaaa/PCConfig",
        "visibility": "PRIVATE",
        "default_branch": "main",
        "local_root": "E:\\PCConfig"
      },
      "displayed_areas": [
        "project_overview",
        "six_modules",
        "current_machine_and_recovery_state",
        "evidence_layers",
        "evolution_and_operating_entries"
      ],
      "impact_sources": [
        {
          "kind": "machine_and_recovery_facts",
          "paths": [
            "registries/*.json",
            "docs/contracts/pcconfig.*.md",
            "docs/governance/*.md",
            "docs/recovery/*.md",
            "tests/*.ps1",
            "tools/Test-PCConfigDrift.ps1",
            "tools/scan_tasks.ps1",
            "tools/Get-DevStorageHealth.ps1",
            "tools/Get-RuntimeInventory.ps1",
            "tools/Install-CoreRecoveryTasks.ps1"
          ]
        },
        {
          "kind": "protected_runtime_and_data",
          "paths": [
            "docs/contracts/pcconfig.core-goal-v2.md",
            "docs/contracts/pcconfig.protected-data-*.md",
            "tools/Invoke-CoreGoalV2.ps1",
            "tools/Invoke-ProtectedPCConfigMajorAction.ps1",
            "tools/Install-ProtectedDataSafeSwitch.ps1",
            "tools/Get-ProtectedPolicyAuthorityStatus.ps1",
            "tools/Test-ProtectedPolicyRetirement.ps1",
            "tools/ProtectedDataVault*/**",
            "registries/protected_policy_retirement.json"
          ]
        },
        {
          "kind": "secrets_and_providers",
          "paths": [
            "registries/secret_broker.json",
            "tools/secret_broker.py",
            "tools/Invoke-SecretBroker.ps1",
            "tools/Invoke-GoogleWorkspaceProvider.ps1",
            "docs/contracts/pcconfig.google-workspace-*.md"
          ]
        }
      ],
      "refresh_rules": {
        "semantic_review_required_when": [
          "a displayed machine, recovery, provider, protected-action or protected-data fact changes meaning",
          "a displayed module boundary, failure state or verification interpretation changes"
        ],
        "snapshot_only_when": [
          "an observation time, count, commit, revision, hash or named status changes without semantic change"
        ],
        "ignore_when": [
          "internal refactors, tests or candidate-only code do not change any displayed fact",
          "a blocked or uninstalled candidate remains accurately described by the current page"
        ]
      }
    },
    {
