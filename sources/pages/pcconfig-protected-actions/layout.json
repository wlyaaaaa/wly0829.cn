    "blocks": [
      {
        "type": "chapter_title",
        "text_ref": "需要确认本人或保护电脑时，会发生什么",
        "align": "left",
        "size": "large",
        "row": "top",
        "width": "58%",
        "row_fit_illustration": true
      },
      {
        "type": "action_button",
        "text_ref": "〔回到项目 → 电脑配置与恢复〕　〔复制 AI 续作说明〕",
        "row": "top",
        "brand_icons": {
          "GitHub": "_library/icons/GitHub标志.png"
        }
      },
      {
        "type": "prose",
        "text_ref": "现在需要确认是我本人时，只有一件事：用我已登记的四种方式之一验证一次。以前那套“设备一旦被判不可信就暂停秘密、十分钟后自动锁磁盘并重启”的设备保护，已经在 2026 年 9 月 26 日停用并删除；密码中心不再锁盘、不自动加密、不强制重启，也不改 BitLocker 的保护方式。",
        "row": "top"
      },
      {
        "type": "illustration",
        "index": 0,
        "row": "top",
        "width": "42%",
        "align": "center"
      }
