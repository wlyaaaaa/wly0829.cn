    "blocks": [
      {
        "type": "chapter_title",
        "text_ref": "从哪里开始",
        "align": "left",
        "size": "medium"
      },
      {
        "type": "prose",
        "text_ref": "讲解视频用 `python -m pipeline.pages init <空影片目录>` 开工，加 `--render` 会顺带做一段试片；想先看全部版式，用 `python -m pipeline.pages atlas <空目录> --render`。原来的逐场分镜工程仍从 `run.ps1 init` 建，再运行 `run.ps1 doctor` 体检；独立网页作品从 `webfilm/run.ps1` 进入。",
        "row": "start",
        "width": "40%"
      },
      {
        "type": "source_text_card",
        "text_ref": "需要准备什么",
        "row": "start",
        "icon_position": "header_left",
        "header_icon": "_library/hires-icons/icon-clean-0432a3e02a060c22b01c.png"
      },
      {
        "type": "section_heading",
        "text_ref": "从开始到拿到结果",
        "row": "start",
        "width": "60%",
