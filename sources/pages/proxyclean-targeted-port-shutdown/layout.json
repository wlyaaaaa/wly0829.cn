      {
        "type": "prose",
        "text_ref": "在 ProxyClean 首页点“关闭代理，恢复普通上网”；若发现多个客户端，先选具体客户端，点下去就开始关闭。单端口维护走独立维护窗口，那里仍先预览再确认。",
        "row": "start",
        "width": "40%"
      },
      {
        "type": "source_text_card",
        "text_ref": "需要准备什么",
