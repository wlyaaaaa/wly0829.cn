      {
        "type": "prose",
        "text_ref": "在已接入 PCConfig 的 AI 对话中说明是同机重装、换机还是故障恢复，先要求恢复清单；实际磁盘操作另按现场核对。",
        "row": "start",
        "width": "40%"
      },
      {
        "type": "source_text_card",
        "text_ref": "需要准备什么",
        "row": "start",
        "icon_position": "header_left",
        "header_icon": "_library/hires-icons/icon-clean-0432a3e02a060c22b01c.png"
      },
