        "align": "left",
        "size": "medium"
      },
      {
        "type": "prose",
        "text_ref": "在 aicli profile list/show 中选择明确 Profile；同一家想换型号时，另存一个自定义配置档并核对它的服务地域、协议和档位，钥匙沿用这家原来那把。启动时在参数里直接加 --model 目前仍会被拒绝。",
        "row": "start",
        "width": "40%"
      },
      {
        "type": "source_text_card",
        "text_ref": "需要准备什么",
        "row": "start",
